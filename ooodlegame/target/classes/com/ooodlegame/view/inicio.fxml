<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ooodlegame.controller.InicioController"
           prefWidth="1440"
           prefHeight="835"
           stylesheets="@style.css">

    <!-- Fondo -->
    <Region styleClass="fondo-blanco"
            maxWidth="Infinity"
            maxHeight="Infinity"/>

    <!-- Contenido principal -->
    <VBox alignment="CENTER" spacing="24">

        <!-- Título -->
        <Label text="Ooodle Game"
               styleClass="etiqueta-titulo"/>

        <!-- Subtítulo -->
        <Label text="Selecciona un rango"
               styleClass="etiqueta-subtitulo"/>

        <!-- Botones de rango -->
        <HBox alignment="CENTER" spacing="16">

            <Button fx:id="btn1a9"
                    text="1 - 9"
                    styleClass="boton-rango"
                    prefWidth="120"
                    prefHeight="54"
                    onAction="#definirRango"/>

            <Button fx:id="btn1a12"
                    text="1 - 12"
                    styleClass="boton-rango"
                    prefWidth="120"
                    prefHeight="54"
                    onAction="#definirRango"/>
        </HBox>

        <!-- Botón iniciar -->
        <Button fx:id="btnIniciar"
                text="Iniciar partida"
                styleClass="boton-iniciar"
                prefWidth="220"
                prefHeight="54"
                onAction="#iniciarJuego">

            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>

        </Button>

    </VBox>

</StackPane>