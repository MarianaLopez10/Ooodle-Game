<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ooodlegame.controller.JuegoController"
           prefWidth="1440"
           prefHeight="835"
           stylesheets="@style.css">

    <!-- Fondo -->
    <Region styleClass="fondo-blanco"
            maxWidth="Infinity"
            maxHeight="Infinity"/>

    <!-- Botón volver -->
    <Button text="Volver"
            styleClass="boton-volver"
            onAction="#volver"
            StackPane.alignment="TOP_LEFT">

        <StackPane.margin>
            <Insets top="20" left="20"/>
        </StackPane.margin>

    </Button>

    <!-- Contenido -->
    <VBox alignment="CENTER" spacing="20">

        <!-- Título -->
        <Label text="Ooodle"
               styleClass="etiqueta-juego-titulo"/>

        <!-- Tabla de intentos -->
        <GridPane fx:id="panelCuadricula"
                  alignment="CENTER"
                  hgap="8"
                  vgap="8">

            <!-- FILA 0 -->
            <TextField fx:id="r0c0" styleClass="campo-celda campo-activo"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label text="×" styleClass="etiqueta-operador"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <TextField fx:id="r0c1" styleClass="campo-celda campo-activo"
                       GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <Label text="+" styleClass="etiqueta-operador"
                   GridPane.rowIndex="0" GridPane.columnIndex="3"/>
            <TextField fx:id="r0c2" styleClass="campo-celda campo-activo"
                       GridPane.rowIndex="0" GridPane.columnIndex="4"/>
            <Label text="-" styleClass="etiqueta-operador"
                   GridPane.rowIndex="0" GridPane.columnIndex="5"/>
            <TextField fx:id="r0c3" styleClass="campo-celda campo-activo"
                       GridPane.rowIndex="0" GridPane.columnIndex="6"/>
            <Label text="=" styleClass="etiqueta-operador"
                   GridPane.rowIndex="0" GridPane.columnIndex="7"/>
            <Label fx:id="r0resultado"
                   text="42"
                   styleClass="celda-resultado celda-resultado-visible"
                   GridPane.rowIndex="0" GridPane.columnIndex="8"/>

            <!-- FILA 1 -->
            <TextField fx:id="r1c0" styleClass="campo-celda"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label text="×" styleClass="etiqueta-operador"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <TextField fx:id="r1c1" styleClass="campo-celda"
                       GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <Label text="+" styleClass="etiqueta-operador"
                   GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            <TextField fx:id="r1c2" styleClass="campo-celda"
                       GridPane.rowIndex="1" GridPane.columnIndex="4"/>
            <Label text="-" styleClass="etiqueta-operador"
                   GridPane.rowIndex="1" GridPane.columnIndex="5"/>
            <TextField fx:id="r1c3" styleClass="campo-celda"
                       GridPane.rowIndex="1" GridPane.columnIndex="6"/>
            <Label text="=" styleClass="etiqueta-operador"
                   GridPane.rowIndex="1" GridPane.columnIndex="7"/>
            <Label fx:id="r1resultado"
                   styleClass="celda-resultado"
                   GridPane.rowIndex="1" GridPane.columnIndex="8"/>

            <!-- FILA 2 -->
            <TextField fx:id="r2c0" styleClass="campo-celda"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label text="×" styleClass="etiqueta-operador"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <TextField fx:id="r2c1" styleClass="campo-celda"
                       GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <Label text="+" styleClass="etiqueta-operador"
                   GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            <TextField fx:id="r2c2" styleClass="campo-celda"
                       GridPane.rowIndex="2" GridPane.columnIndex="4"/>
            <Label text="-" styleClass="etiqueta-operador"
                   GridPane.rowIndex="2" GridPane.columnIndex="5"/>
            <TextField fx:id="r2c3" styleClass="campo-celda"
                       GridPane.rowIndex="2" GridPane.columnIndex="6"/>
            <Label text="=" styleClass="etiqueta-operador"
                   GridPane.rowIndex="2" GridPane.columnIndex="7"/>
            <Label fx:id="r2resultado"
                   styleClass="celda-resultado"
                   GridPane.rowIndex="2" GridPane.columnIndex="8"/>

            <!-- FILA 3 -->
            <TextField fx:id="r3c0" styleClass="campo-celda"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label text="×" styleClass="etiqueta-operador"
                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <TextField fx:id="r3c1" styleClass="campo-celda"
                       GridPane.rowIndex="3" GridPane.columnIndex="2"/>
            <Label text="+" styleClass="etiqueta-operador"
                   GridPane.rowIndex="3" GridPane.columnIndex="3"/>
            <TextField fx:id="r3c2" styleClass="campo-celda"
                       GridPane.rowIndex="3" GridPane.columnIndex="4"/>
            <Label text="-" styleClass="etiqueta-operador"
                   GridPane.rowIndex="3" GridPane.columnIndex="5"/>
            <TextField fx:id="r3c3" styleClass="campo-celda"
                       GridPane.rowIndex="3" GridPane.columnIndex="6"/>
            <Label text="=" styleClass="etiqueta-operador"
                   GridPane.rowIndex="3" GridPane.columnIndex="7"/>
            <Label fx:id="r3resultado"
                   styleClass="celda-resultado"
                   GridPane.rowIndex="3" GridPane.columnIndex="8"/>

            <!-- FILA 4 -->
            <TextField fx:id="r4c0" styleClass="campo-celda"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label text="×" styleClass="etiqueta-operador"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <TextField fx:id="r4c1" styleClass="campo-celda"
                       GridPane.rowIndex="4" GridPane.columnIndex="2"/>
            <Label text="+" styleClass="etiqueta-operador"
                   GridPane.rowIndex="4" GridPane.columnIndex="3"/>
            <TextField fx:id="r4c2" styleClass="campo-celda"
                       GridPane.rowIndex="4" GridPane.columnIndex="4"/>
            <Label text="-" styleClass="etiqueta-operador"
                   GridPane.rowIndex="4" GridPane.columnIndex="5"/>
            <TextField fx:id="r4c3" styleClass="campo-celda"
                       GridPane.rowIndex="4" GridPane.columnIndex="6"/>
            <Label text="=" styleClass="etiqueta-operador"
                   GridPane.rowIndex="4" GridPane.columnIndex="7"/>
            <Label fx:id="r4resultado"
                   styleClass="celda-resultado"
                   GridPane.rowIndex="4" GridPane.columnIndex="8"/>

            <!-- FILA 5 -->
            <TextField fx:id="r5c0" styleClass="campo-celda"
                       GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Label text="×" styleClass="etiqueta-operador"
                   GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <TextField fx:id="r5c1" styleClass="campo-celda"
                       GridPane.rowIndex="5" GridPane.columnIndex="2"/>
            <Label text="+" styleClass="etiqueta-operador"
                   GridPane.rowIndex="5" GridPane.columnIndex="3"/>
            <TextField fx:id="r5c2" styleClass="campo-celda"
                       GridPane.rowIndex="5" GridPane.columnIndex="4"/>
            <Label text="-" styleClass="etiqueta-operador"
                   GridPane.rowIndex="5" GridPane.columnIndex="5"/>
            <TextField fx:id="r5c3" styleClass="campo-celda"
                       GridPane.rowIndex="5" GridPane.columnIndex="6"/>
            <Label text="=" styleClass="etiqueta-operador"
                   GridPane.rowIndex="5" GridPane.columnIndex="7"/>
            <Label fx:id="r5resultado"
                   styleClass="celda-resultado"
                   GridPane.rowIndex="5" GridPane.columnIndex="8"/>

        </GridPane>

        <!-- Botón validar -->
        <Button text="Validar ecuación"
                styleClass="boton-validar"
                onAction="#validarEcuacion"
                prefWidth="220"
                prefHeight="54">

            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>

        </Button>

    </VBox>

</StackPane>
